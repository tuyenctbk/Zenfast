<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="200dp"
    android:height="200dp"
    android:viewportWidth="200"
    android:viewportHeight="200">
    
    <!-- Outer Glow Circle -->
    <path
        android:pathData="M 100,10 A 90,90 0 1,1 99.9,10 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="100"
                android:centerY="100"
                android:gradientRadius="90"
                android:type="radial">
                <item android:color="#3310B981" android:offset="0.0" />
                <item android:color="#000F1715" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Outer Fasting Ring Arc -->
    <path
        android:pathData="M 100,30 A 70,70 0 1,1 40,60"
        android:strokeWidth="10"
        android:strokeLineCap="round"
        android:fillColor="#00000000">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="30"
                android:startY="30"
                android:endX="170"
                android:endY="170"
                android:type="linear">
                <item android:color="#10B981" android:offset="0.0" />
                <item android:color="#06B6D4" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Amber Target Accent Arc -->
    <path
        android:pathData="M 100,30 A 70,70 0 0,1 170,100"
        android:strokeWidth="10"
        android:strokeLineCap="round"
        android:fillColor="#00000000">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="100"
                android:startY="30"
                android:endX="170"
                android:endY="100"
                android:type="linear">
                <item android:color="#F59E0B" android:offset="0.0" />
                <item android:color="#10B981" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Inner Zen Leaf Flame -->
    <path
        android:pathData="M 100,55 C 80,80 80,110 100,135 C 120,110 120,80 100,55 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="100"
                android:startY="55"
                android:endX="100"
                android:endY="135"
                android:type="linear">
                <item android:color="#34D399" android:offset="0.0" />
                <item android:color="#059669" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
    
    <!-- Inner Drop Accent -->
    <path
        android:pathData="M 100,75 C 90,90 90,105 100,120 C 110,105 110,90 100,75 Z"
        android:fillColor="#A7F3D0" />
</vector>
